# Root example (mostly for reference / local full stack)

# Netlify environment variables (set in Netlify dashboard)
PYTHON_API_URL=https://your-backend.up.railway.app   # or https://xxx.onrender.com
PYTHON_API_KEY=your-shared-secret

# Backend
API_KEY=your-shared-secret
ALLOWED_ORIGINS=https://your-netlify-site.netlify.app
REQUEST_TIMEOUT=20